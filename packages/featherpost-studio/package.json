{
  "name": "@featherpost/studio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../i18n compile && vite --host 127.0.0.1 --port 1421 --strictPort",
    "build": "pnpm --dir ../i18n compile && tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "pnpm --dir ../i18n compile && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../i18n compile && vitest run"
  },
  "dependencies": {
    "@featherpost/i18n": "workspace:*",
    "@tauri-apps/api": "^2.8.0",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "jsdom": "31.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
