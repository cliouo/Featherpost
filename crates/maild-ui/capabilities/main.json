{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "主窗口：核心事件 + 显式列出的桥命令。窗口管理只开 start_dragging（隐藏标题栏后由 data-tauri-drag-region 拖动窗口），没有文件、shell、HTTP、进程或其他窗口管理权限（保存附件与打开链接都经 Rust 命令校验后执行，webview 拿不到路径或 URL 权限）；第三方扩展视图（E02）另建 capability，不复用本条。",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-ui-settings-profiles",
    "allow-ui-settings-probe",
    "allow-ui-settings-save-account",
    "allow-ui-settings-account-action",
    "allow-ui-settings-rules",
    "allow-ui-settings-notification",
    "allow-ui-settings-addresses",
    "allow-ui-settings-address-action",
    "allow-ui-settings-packages",
    "allow-ui-settings-package-action",
    "allow-ui-settings-rollback-preview",
    "allow-ui-settings-rollback",
    "allow-ui-settings-install",
    "allow-ui-settings-cancel-package",
    "allow-ui-settings-pick-package",

    "core:default",
    "core:window:allow-start-dragging",
    "allow-ui-snapshot",
    "allow-ui-list-folders",
    "allow-ui-list-messages",
    "allow-ui-get-message",
    "allow-ui-refresh",
    "allow-ui-frontend-info",
    "allow-ui-claim-intent",
    "allow-ui-prepare-html",
    "allow-ui-release-html",
    "allow-ui-open-link",
    "allow-ui-save-attachment",
    "allow-ui-reading-policy",
    "allow-ui-set-reading-policy",
    "allow-ui-locale",
    "allow-ui-locale-preference",
    "allow-ui-set-locale-preference",
    "allow-ui-senders",
    "allow-ui-drafts",
    "allow-ui-draft",
    "allow-ui-new-draft",
    "allow-ui-save-draft",
    "allow-ui-reply-draft",
    "allow-ui-send-draft",
    "allow-ui-resolve-send",
    "allow-ui-discard-draft",
    "allow-ui-pick-files",
    "allow-ui-upload-file",
    "allow-ui-release-file",
    "allow-ui-finish-upload",
    "allow-ui-cancel-upload",
    "allow-ui-finish-close",
    "allow-ui-compose-ready",
    "allow-ui-mailbox-profiles",
    "allow-ui-mailbox-query",
    "allow-ui-mailbox-thread",
    "allow-ui-mailbox-locate",
    "allow-ui-mailbox-index",
    "allow-ui-mailbox-write",
    "allow-ui-mailbox-activity",
    "allow-ui-mailbox-resolve",
    "allow-ui-sync-mailbox",
    "allow-ui-sync-mailbox-scope",
    "allow-ui-mailbox-sync-status",
    "allow-ui-server-search",
    "allow-ui-fetch-server-message",
    "allow-ui-settings-discover-provider",
    "allow-ui-discover-provider",
    "allow-ui-open-external-url"
  ]
}
